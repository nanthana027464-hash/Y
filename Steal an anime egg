-- 2. ระบบป้องกันการโจมตี (God Mode / Anti-Damage)
--------------------------------------------------------------------
local GodModeEnabled = false

PlayerTab:CreateToggle({
   Name = "เปิด / ปิด ป้องกันการโจมตี (God Mode)",
   CurrentValue = false,
   Flag = "GodModeToggle",
   Callback = function(Value)
      GodModeEnabled = Value
      if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
         local hum = LocalPlayer.Character.Humanoid
         if GodModeEnabled then
            hum:SetStateEnabled(Enum.HumanoidStateType.Dead, false)
         else
            hum:SetStateEnabled(Enum.HumanoidStateType.Dead, true)
         end
      end
   end,
})

-- Loop รักษาสุขภาพตัวละคร
task.spawn(function()
    while task.wait(0.1) do
        if GodModeEnabled and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
            local hum = LocalPlayer.Character.Humanoid
            if hum.Health < hum.MaxHealth then
                hum.Health = hum.MaxHealth
            end
        end
    end
end)

--------------------------------------------------------------------
-- 3. ระบบหยิบไข่ไว (Instant Egg Grab / ProximityPrompt)
--------------------------------------------------------------------
local FastEggEnabled = false
local OriginalHoldDurations = {}

EggTab:CreateToggle({
   Name = "เปิด / ปิด หยิบไข่ไว (Instant Egg Grab)",
   CurrentValue = false,
   Flag = "FastEggToggle",
   Callback = function(Value)
      FastEggEnabled = Value
      for _, prompt in ipairs(workspace:GetDescendants()) do
         if prompt:IsA("ProximityPrompt") then
            if FastEggEnabled then
               if not OriginalHoldDurations[prompt] then
                  OriginalHoldDurations[prompt] = prompt.HoldDuration
               end
               prompt.HoldDuration = 0
            else
               if OriginalHoldDurations[prompt] then
                  prompt.HoldDuration = OriginalHoldDurations[prompt]
               end
            end
         end
      end
   end,
})

workspace.DescendantAdded:Connect(function(descendant)
    if descendant:IsA("ProximityPrompt") and FastEggEnabled then
        OriginalHoldDurations[descendant] = descendant.HoldDuration
        descendant.HoldDuration = 0
    end
end)

--------------------------------------------------------------------
-- 4. ระบบบอกระดับความแรร์ของไข่ (Egg Rarity ESP)
--------------------------------------------------------------------
local EggESPEnabled = false
local ActiveEggGuis = {}

local function AddEggESP(object)
    if object:IsA("Model") or object:IsA("BasePart") then
        local nameLower = string.lower(object.Name)
        if string.find(nameLower, "egg") or object:FindFirstChild("Rarity") or object:GetAttribute("Rarity") then
            local targetPart = object:IsA("Model") and (object.PrimaryPart or object:FindFirstChildWhichIsA("BasePart")) or object
            if targetPart and not targetPart:FindFirstChild("EggESP_UI") then
                
                -- ดึงค่าระดับความแรร์ (Rarity)
                local rarityText = "Common"
                if object:GetAttribute("Rarity") then
                    rarityText = tostring(object:GetAttribute("Rarity"))
                elseif object:FindFirstChild("Rarity") then
                    rarityText = tostring(object.Rarity.Value)
                else
                    rarityText = object.Name
                end

                -- สร้าง BillboardGui แสดงข้อความลอยบนไข่
                local bgui = Instance.new("BillboardGui")
                bgui.Name = "EggESP_UI"
                bgui.Adornee = targetPart
                bgui.Size = UDim2.new(0, 150, 0, 40)
                bgui.StudsOffset = Vector3.new(0, 2.5, 0)
                bgui.AlwaysOnTop = true

                local textLabel = Instance.new("TextLabel")
                textLabel.Parent = bgui
                textLabel.Size = UDim2.new(1, 0, 1, 0)
                textLabel.BackgroundTransparency = 1
                textLabel.Text = "🥚 " .. object.Name .. "\n[" .. rarityText .. "]"
                textLabel.TextColor3 = Color3.fromRGB(255, 215, 0) -- ข้อความสีทอง
                textLabel.TextStrokeTransparency = 0
                textLabel.TextSize = 14
                textLabel.Font = Enum.Font.SourceSansBold

                bgui.Parent = targetPart
                table.insert(ActiveEggGuis, bgui)
            end
        end
    end
end

local function RemoveEggESP()
    for _, gui in ipairs(ActiveEggGuis) do
        if gui and gui.Parent then
            gui:Destroy()
        end
    end
    ActiveEggGuis = {}
end

EggTab:CreateToggle({
   Name = "เปิด / ปิด แสดงความแรร์ไข่ (Egg Rarity ESP)",
   CurrentValue = false,
   Flag = "EggESPToggle",
   Callback = function(Value)
      EggESPEnabled = Value
      if EggESPEnabled then
         for _, obj in ipairs(workspace:GetDescendants()) do
            AddEggESP(obj)
         end
      else
         RemoveEggESP()
      end
   end,
})

workspace.DescendantAdded:Connect(function(descendant)
    if EggESPEnabled then
        task.wait(0.2)
        AddEggESP(descendant)
    end
end)

